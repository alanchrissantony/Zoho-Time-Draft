# zoho-timelog settings: `timelog install` copies this to ~/.timelog/config.env and never overwrites it.
# Everything is optional. Uncomment a line to change it. Real environment variables win over this file.

# Review app port. Zoho login redirects to http://127.0.0.1:<port>/oauth/callback, so keep 8765
# unless that port is taken.
# TIMELOG_PORT=8765

# Claude models for drafting (jobs and descriptions) and for reading the Outlook calendar
# TIMELOG_MODEL=sonnet
# TIMELOG_MEETINGS_MODEL=haiku

# 0 = don't read Outlook meetings (e.g. no Microsoft 365 connector in claude.ai)
# TIMELOG_MEETINGS=1

# Local record of every time log sent to Zoho
# LOG_FILE=~/.timelog/zoho_submissions.log

# Zoho data centre: zoho.in, zoho.com, zoho.eu, zoho.com.au …
# ZOHO_DOMAIN=zoho.in
